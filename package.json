{
  "name": "yourstyle-pos",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clasp:status:dev": "clasp -P \"$PWD/.clasp.dev.json\" status",
    "clasp:status:prod": "clasp -P \"$PWD/.clasp.prod.json\" status",
    "clasp:push:dev": "clasp -P \"$PWD/.clasp.dev.json\" push",
    "clasp:push:prod": "npm run check && clasp -P \"$PWD/.clasp.prod.json\" push",
    "clasp:push:both": "npm run check && clasp -P \"$PWD/.clasp.dev.json\" push && clasp -P \"$PWD/.clasp.prod.json\" push",
    "lint": "eslint .",
    "validate": "node scripts/validate-project.mjs",
    "format": "prettier --write \".github/workflows/*.yml\" \".prettierrc.json\" \"appsscript.json\" \"eslint.config.mjs\" \"package.json\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \".github/workflows/*.yml\" \".prettierrc.json\" \"appsscript.json\" \"eslint.config.mjs\" \"package.json\" \"scripts/**/*.mjs\"",
    "check": "npm run lint && npm run validate && npm run format:check && npm test",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@google/clasp": "3.4.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6"
  }
}
